# suited-parents
# Leave both unset for development against the sandbox (guardian picker, x-guardian-id header).
VITE_CLERK_PUBLISHABLE_KEY=        # pk_live_… of the parents.suited.ae Clerk application; REQUIRED for a production build
VITE_MONEY_API_URL=                # e.g. https://money-api.suited.ae ; unset → /api via the Vite dev proxy
# Dev proxy target (where the sandbox runs)
MONEY_API_URL=http://localhost:3100
VITE_LEARNING_API_URL=             # e.g. https://api.suited.so/api ; unset → /learning via the Vite dev proxy (LEARNING_API_URL, default http://localhost:3001)
